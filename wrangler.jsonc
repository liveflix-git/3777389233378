{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "espia-ai3",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  }
}
